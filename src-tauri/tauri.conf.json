{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kingsmith Controller",
  "mainBinaryName": "kingsmith-controller",
  "version": "0.1.0",
  "identifier": "local.kingsmithcontroller",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kingsmith Controller",
        "width": 360,
        "height": 560,
        "minWidth": 320,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "HealthcareAndFitness",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "android": {
      "minSdkVersion": 31
    }
  }
}
